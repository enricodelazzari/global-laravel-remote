{
    "name": "enricodelazzari/remote-cli",
    "description": "Execute artisan commands on your server, from anywhere",
    "keywords": [
        "laravel",
        "artisan",
        "remote",
        "ssh",
        "cli"
    ],
    "homepage": "https://github.com/enricodelazzari/global-laravel-remote",
    "support": {
        "issues": "https://github.com/enricodelazzari/global-laravel-remote/issues",
        "source": "https://github.com/enricodelazzari/global-laravel-remote"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Enrico Delazzari",
            "role": "Developer"
        },
        {
            "name": "Francisco Madeira",
            "role": "Developer of the original package"
        },
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "role": "Developer of the original package"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel-zero/framework": "^13.0",
        "laravel/prompts": "^0.3.22",
        "spatie/laravel-remote": "^1.5",
        "spatie/valuestore": "^1.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["remote-cli"]
}
